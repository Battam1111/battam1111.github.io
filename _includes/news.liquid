<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news = site.news | reverse %}
    {% if include.limit and page.announcements.limit %}
      {% assign news_limit = page.announcements.limit %}
    {% else %}
      {% assign news_limit = news_size %}
    {% endif %}
    <ol class="timeline">
      {% for item in news limit: news_limit %}
        <li class="timeline__item">
          <time class="timeline__date" datetime="{{ item.date | date: '%Y-%m-%d' }}"><span lang="en">{{ item.date | date: '%b %d, %Y' }}</span><span lang="zh">{{ item.date | date: '%Y年%-m月%-d日' }}</span><span lang="ja">{{ item.date | date: '%Y年%-m月%-d日' }}</span></time>
          <div class="timeline__body">
            {% if item.inline %}
              {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
            {% else %}
              <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ol>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
