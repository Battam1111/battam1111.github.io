<header class="site-header" id="site-header">
  <div class="site-header__bar wrap">
    <a class="site-title{% if page.permalink == '/' %} site-title--home{% endif %}" href="{{ site.baseurl }}/">
      {%- if site.title == 'blank' -%}
        {%- if site.first_name -%}<span class="site-title__first">{{- site.first_name -}}</span>{%- endif -%}
        {%- if site.middle_name %} {{ site.middle_name -}}{%- endif -%}
        {%- if site.last_name %} {{ site.last_name -}}{%- endif -%}
      {%- else -%}
        {{- site.title -}}
      {%- endif -%}
    </a>

    {% for p in site.pages %}
      {% if p.permalink == '/' %}{% assign about_title = p.title %}{% endif %}
    {% endfor %}
    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul class="site-nav__list">
        <li>
          <a class="site-nav__link{% if page.permalink == '/' %} is-active{% endif %}" href="{{ '/' | relative_url }}"{% if page.permalink == '/' %} aria-current="page"{% endif %}>
            {%- if about_title == 'About' -%}
              <span lang="en">About</span><span lang="zh">关于</span><span lang="ja">プロフィール</span>
            {%- else -%}
              {{- about_title }}
            {%- endif -%}
            {% if page.permalink == '/' %}<span class="sr-only">(current)</span>{% endif %}
          </a>
        </li>
        {% assign sorted_pages = site.pages | sort: 'nav_order' %}
        {% for p in sorted_pages %}
          {% if p.nav and p.autogen == null %}
            {%- if p.permalink contains '://' -%}
              {%- assign url = p.permalink -%}
            {%- elsif p.permalink contains '/blog/' -%}
              {%- assign url = '/blog/' -%}
            {%- else -%}
              {%- assign url = p.url -%}
            {%- endif -%}
            {% assign parent_link = p.permalink | remove: 'index.html' %}
            {% assign nav_active = false %}
            {% if page.url contains parent_link %}{% assign nav_active = true %}{% endif %}
            <li>
              <a class="site-nav__link{% if nav_active %} is-active{% endif %}" href="{{ url | relative_url }}"{% if page.url == url %} aria-current="page"{% endif %}>
                {%- if p.title == 'About' -%}
                  <span lang="en">About</span><span lang="zh">关于</span><span lang="ja">プロフィール</span>
                {%- elsif p.title == 'Publications' -%}
                  <span lang="en">Publications</span><span lang="zh">论文</span><span lang="ja">論文</span>
                {%- elsif p.title == 'News' -%}
                  <span lang="en">News</span><span lang="zh">近况</span><span lang="ja">お知らせ</span>
                {%- elsif p.title == 'Notes' -%}
                  <span lang="en">Notes</span><span lang="zh">笔记</span><span lang="ja">ノート</span>
                {%- elsif p.title == 'Projects' -%}
                  <span lang="en">Projects</span><span lang="zh">项目</span><span lang="ja">プロジェクト</span>
                {%- else -%}
                  {{- p.title }}
                {%- endif -%}
                {% if page.url contains p.url %}<span class="sr-only">(current)</span>{% endif %}
              </a>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </nav>

    <div class="site-tools">
      <!-- Language switcher (EN / 中 / 日): each link goes to this page in that language (polyglot builds /zh/ and /ja/).
           No lang attribute on the links: an element with another lang is dropped from each build (_plugins/lang-blocks.rb). -->
      {% capture page_path %}{{ page.url | replace: 'index.html', '' }}{% endcapture %}
      <div class="lang-switch" role="group" aria-label="Language switcher">
        {% for l in site.languages %}
          {% case l %}
            {% when 'zh' %}{% assign pill = '中' %}{% assign pill_title = '中文' %}
            {% when 'ja' %}{% assign pill = '日' %}{% assign pill_title = '日本語' %}
            {% else %}{% assign pill = 'EN' %}{% assign pill_title = 'English' %}
          {% endcase %}
          <a {% static_href %}href="{{ site.baseurl }}{% if l != site.default_lang %}/{{ l }}{% endif %}{{ page_path }}"{% endstatic_href %} hreflang="{{ l }}" data-lang="{{ l }}" title="{{ pill_title }}"{% if l == site.active_lang %} class="active" aria-current="page"{% endif %}>{{ pill }}</a>
        {% endfor %}
      </div>
      {% if site.enable_darkmode %}
        <button class="icon-button theme-button" id="theme-toggle" type="button" title="Change theme" aria-label="Change theme">
          {%- include icons/auto.svg -%}{%- include icons/sun.svg -%}{%- include icons/moon.svg -%}
        </button>
      {% endif %}
      <button class="icon-button menu-button" id="menu-toggle" type="button" aria-controls="site-nav" aria-expanded="false">
        <span class="sr-only">Toggle navigation</span>
        {%- include icons/menu.svg -%}{%- include icons/close.svg -%}
      </button>
    </div>
  </div>
</header>
