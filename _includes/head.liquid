<!-- Metadata, OpenGraph and Schema.org -->
{% include metadata.liquid %}

{% comment %}
  Content Security Policy: only this site, GoatCounter (script, count, footer counter) and, on a page with
  Vega-Lite charts, jsDelivr for the Vega scripts. 'unsafe-inline' stays for the theme script below, the inline
  scripts of a post's figures and their inline styles. The site's CSP has no 'unsafe-eval' (see vega-setup.js).
{% endcomment %}
{% assign vega_page = false %}
{% if page.chart and page.chart.vega_lite %}{% assign vega_page = true %}{% endif %}
<meta
  http-equiv="Content-Security-Policy"
  content="default-src 'self'; script-src 'self' 'unsafe-inline' https://gc.zgo.at{% if vega_page %} https://cdn.jsdelivr.net{% endif %}; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://{{ site.goatcounter_username }}.goatcounter.com; font-src 'self'; media-src 'self'; connect-src 'self' https://{{ site.goatcounter_username }}.goatcounter.com; object-src 'none'; base-uri 'self'; form-action 'self'"
>

<!-- Theme before any CSS loads, so a dark page never flashes light: the setting is system, light or dark
     (localStorage "theme"); data-theme on <html> is what the stylesheet reads. "js" lets the CSS fold the phone menu
     and gates everything that needs the scripts. -->
<script>
  (function () {
    var root = document.documentElement;
    root.classList.add('js');
    // The first page of a visit plays the entrance once ("intro", see _sass/site/_motion.scss); later pages
    // arrive through the view transition instead.
    try {
      if (!sessionStorage.getItem('seen')) {
        root.classList.add('intro');
        sessionStorage.setItem('seen', '1');
      }
    } catch (e) {}
    window.determineThemeSetting = function () {
      var s = null;
      try { s = localStorage.getItem('theme'); } catch (e) {}
      return s === 'light' || s === 'dark' ? s : 'system';
    };
    window.determineComputedTheme = function () {
      var s = window.determineThemeSetting();
      if (s !== 'system') return s;
      return window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    };
    root.setAttribute('data-theme-setting', window.determineThemeSetting());
    root.setAttribute('data-theme', window.determineComputedTheme());
  })();
</script>

<link rel="preload" href="/assets/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/newsreader-latin.woff2" as="font" type="font/woff2" crossorigin>
<!-- Cache-bust for the compiled stylesheet: the build passes the commit id as asset_version (see DEVELOPMENT.md section 3). -->
<link rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url }}?v={{ site.asset_version | default: 'dev' }}">

{% if site.icon.size <= 4 %}
  <link
    rel="shortcut icon"
    href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>{{ site.icon }}</text></svg>"
  >
{% elsif site.icon != blank %}
  <link rel="icon" href="{{ site.icon | prepend: '/assets/img/' | relative_url | bust_file_cache }}">
{% endif %}
{% comment %}
  One URL per language (jekyll-polyglot builds English at /, Chinese under /zh/, Japanese under /ja/).
  Each version is canonical for itself and names the other two with hreflang; x-default is the English root.
  static_href keeps polyglot from prefixing these links with the language of the build.
{% endcomment %}
{% capture page_path %}{{ page.url | replace: 'index.html', '' }}{% endcapture %}
<link rel="canonical" {% static_href %}href="{{ site.url }}{{ site.baseurl }}{% if site.active_lang != site.default_lang %}/{{ site.active_lang }}{% endif %}{{ page_path }}"{% endstatic_href %}>
{% for l in site.languages %}
  <link rel="alternate" hreflang="{{ l }}" {% static_href %}href="{{ site.url }}{{ site.baseurl }}{% if l != site.default_lang %}/{{ l }}{% endif %}{{ page_path }}"{% endstatic_href %}>
{% endfor %}
<link rel="alternate" hreflang="x-default" {% static_href %}href="{{ site.url }}{{ site.baseurl }}{{ page_path }}"{% endstatic_href %}>
<!-- The Notes feed of this language (jekyll-feed writes one per language build). -->
<link rel="alternate" type="application/atom+xml" title="{{ site.first_name }} {{ site.last_name }}, Notes" {% static_href %}href="{{ site.url }}{{ site.baseurl }}{% if site.active_lang != site.default_lang %}/{{ site.active_lang }}{% endif %}/feed.xml"{% endstatic_href %}>

{% if site.goatcounter_username and site.goatcounter_username != "" %}
  <!-- GoatCounter: privacy-friendly, cookieless analytics (no PII). -->
  <script data-goatcounter="https://{{ site.goatcounter_username }}.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
{% endif %}
