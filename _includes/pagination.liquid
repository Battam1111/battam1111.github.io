{% if paginator.total_pages > 1 %}
  <nav class="pagination" aria-label="Blog page navigation">
    <ul>
      <li>
        {% if paginator.previous_page %}<a href="{{ paginator.previous_page_path | relative_url }}">&lt;</a>{% else %}<span aria-disabled="true">&lt;</span>{% endif %}
      </li>
      {% if paginator.page_trail %}
        {% for trail in paginator.page_trail %}
          <li>
            <a href="{{ trail.path | relative_url | remove: 'index.html' }}" title="{{ trail.title }}"{% if page.url == trail.path %} aria-current="page"{% endif %}>{{ trail.num }}</a>
          </li>
        {% endfor %}
      {% endif %}
      <li>
        {% if paginator.next_page %}<a href="{{ paginator.next_page_path | relative_url }}">&gt;</a>{% else %}<span aria-disabled="true">&gt;</span>{% endif %}
      </li>
    </ul>
  </nav>
{% endif %}
