{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    <span lang="en">Last updated: {{ 'now' | date: '%B %d, %Y' }}.</span><span lang="zh">最近更新：{{ 'now' | date: '%Y年%-m月%-d日' }}。</span><span lang="ja">最終更新：{{ 'now' | date: '%Y年%-m月%-d日' }}。</span>
  {% endif %}
  {% if site.goatcounter_username and site.goatcounter_username != "" and site.goatcounter_show_counter %}
    {%- comment -%}
      v23: Discrete visit counter. Renders an inline SVG from GoatCounter.
      Styled to match footer text size and color so it sits quietly at the end of the line.
    {%- endcomment -%}
    <span class="visit-counter" aria-label="Visits">
      <span lang="en">·&nbsp;</span><span lang="zh">·&nbsp;</span><span lang="ja">·&nbsp;</span>
      <img
        src="https://{{ site.goatcounter_username }}.goatcounter.com/counter/TOTAL.svg?style=plain&nofont"
        alt="visits"
        loading="lazy"
        decoding="async">
    </span>
  {% endif %}
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}
