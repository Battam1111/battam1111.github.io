<footer class="site-footer" role="contentinfo">
  <div class="site-footer__inner wrap">
    <p>
      &copy; Copyright {{ site.time | date: '%Y' }}
      {{ site.first_name }}
      {{ site.middle_name }}
      {{ site.last_name }}. {{ site.footer_text }}
      {% if site.impressum_path %}
        <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
      {% endif %}
    </p>
    <p>
      {% if site.last_updated %}
        <span lang="en">Last updated: {{ 'now' | date: '%B %d, %Y' }}.</span><span lang="zh">最近更新：{{ 'now' | date: '%Y年%-m月%-d日' }}。</span><span lang="ja">最終更新：{{ 'now' | date: '%Y年%-m月%-d日' }}。</span>
      {% endif %}
      {% if site.goatcounter_username and site.goatcounter_username != "" and site.goatcounter_show_counter %}
        {%- comment -%}
          The visit counter: assets/js/site.js fetches GoatCounter's public total and writes the plain number in;
          it stays hidden (data-vc-hidden) until then, and for good if the fetch fails.
        {%- endcomment -%}
        <span class="visit-counter" aria-label="Total unique visitors" data-vc-hidden data-vc-source="https://{{ site.goatcounter_username }}.goatcounter.com/counter/TOTAL.json">
          <span lang="en">·&nbsp;</span><span lang="zh">·&nbsp;</span><span lang="ja">·&nbsp;</span>
          <span class="vc-count" data-vc-count></span>
          <span class="vc-unit" lang="en">&nbsp;views</span><span class="vc-unit" lang="zh">&nbsp;次访问</span><span class="vc-unit" lang="ja">&nbsp;回</span>
        </span>
      {% endif %}
    </p>
  </div>
</footer>
