<!doctype html>
<html lang="{{ site.active_lang | default: site.lang }}">
  <head>
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = site.baseurl | append: '/' %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign redirect = page.redirect | relative_url %}
      {% endif %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}
    {% include head.liquid %}
  </head>
  <body class="layout-{{ page.layout | default: 'page' }}{% if page.permalink == '/' %} is-home{% elsif page.permalink == '/404.html' %} is-404{% endif %}">
    {% include header.liquid %}
    <main class="site-main" id="main">
      {{ content }}
    </main>
    {% include footer.liquid %}
    <template id="icon-copy">{% include icons/copy.svg %}</template>
    <template id="icon-check">{% include icons/check.svg %}</template>
    <template id="icon-arrow-up">{% include icons/arrow-up.svg %}</template>
    {% include scripts.liquid %}
  </body>
</html>
